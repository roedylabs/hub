{
  "name": "@roedy/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Svelte 5 components, actions and helpers shared by the Roedy apps, with their own English and German texts",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./base.css": "./base.css"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.59.1",
    "axe-core": "^4.14.1"
  },
  "dependencies": {
    "@roedy/tokens": "workspace:*",
    "@tabler/icons-svelte-runes": "3.52.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    }
  }
}
