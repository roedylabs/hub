{
  "name": "@roedy/ui",
  "version": "0.1.0",
  "description": "Svelte 5 components, actions and helpers shared by the Roedy apps, with their own English and German texts",
  "keywords": [
    "roedy",
    "svelte",
    "svelte5",
    "components"
  ],
  "homepage": "https://github.com/roedylabs/hub/tree/main/packages/ui#readme",
  "bugs": "https://github.com/roedylabs/hub/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedylabs/hub.git",
    "directory": "packages/ui"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./base.css": "./base.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "base.css"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "./base.css": "./base.css"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "package": "svelte-package -i src -o dist --tsconfig tsconfig.package.json",
    "prepack": "pnpm run package && cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE"
  },
  "peerDependencies": {
    "axe-core": "^4.14.1",
    "svelte": "^5.59.1"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    }
  },
  "dependencies": {
    "@roedy/tokens": "workspace:*",
    "@tabler/icons-svelte-runes": "3.52.0"
  },
  "devDependencies": {
    "@sveltejs/package": "3.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
