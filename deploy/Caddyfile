# Caddy in front of Roedy Hub (deploy/compose.yml, docs/ops.md › Reverse
# proxy). The site address is ROEDY_PUBLIC_URL (CADDY_SITE in compose.yml);
# Caddy obtains the certificate and redirects HTTP by itself. Every path of the
# origin goes to the hub, which routes /<slug>/… to the apps itself.
#
# Caddy sets X-Forwarded-For to the client's address (it ignores the client's
# own header, as long as no trusted_proxies are configured), which is what
# ROEDY_TRUST_PROXY=true expects. Request and response headers pass unchanged;
# bodies, Server-Sent Events and WebSockets are streamed without a size or time
# limit.

{$CADDY_SITE} {
	# The hub does not compress. Only these types: never text/event-stream,
	# whose events must not wait in a compressor's buffer.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type text/plain*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}
	reverse_proxy roedy-hub:8080
}
