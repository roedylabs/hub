# Settings for deploy/compose.yml. Copy this file to .env next to compose.yml
# and adjust it:
#
#   cp .env.example .env && chmod 600 .env
#
# Empty values count as unset. All variables of the hub: docs/ops.md ›
# Configuration.

# Required: public address of the hub – scheme and host, no path; replace the
# example host with your own. Caddy obtains the certificate for this host, the
# apps live under /<slug>/ of it. Without it, nothing starts.
ROEDY_PUBLIC_URL=https://app.example.com

# Version of the hub's image: 0.1 follows the patches of 0.1.x, 0.1.0 is
# exactly that version, empty means latest (docs/ops.md › Updates).
ROEDY_IMAGE_TAG=

# User and group IDs the hub runs as (default 65532, the image's user). Only
# change them together with a data directory that belongs to these IDs, e.g. a
# bind mount; never 0 (docs/ops.md › Container user).
ROEDY_UID=
ROEDY_GID=

# Log filter (default info) and format: json (default) or text.
ROEDY_LOG=
ROEDY_LOG_FORMAT=

# Number of reverse proxies in front of the hub. compose.yml uses true (Caddy)
# as long as the variable is missing; set to empty, it turns it off. So leave it
# commented out unless there is another proxy in front of Caddy (then 2, and
# the apps 3).
# ROEDY_TRUST_PROXY=true

# Instance key for secrets in the database: 64 hex characters
# (openssl rand -hex 32). Without it, the first start creates /data/secret.key.
# Back it up either way (docs/ops.md › Instance key). Alternatively a path to a
# file with the key inside the container, e.g. /run/secrets/roedy_secret_key;
# not both. compose.yml does not provide that file: add a Docker secret or a
# read-only volume for it there, otherwise the hub does not start.
ROEDY_SECRET_KEY=
ROEDY_SECRET_KEY_FILE=

# The private network of the hub and the apps, and the hub's fixed address in
# it (its internal listener binds to that address only). Change both together
# if the subnet collides with a network of the host.
ROEDY_APPS_SUBNET=
ROEDY_HUB_APPS_IP=

# Fixed by the image and compose.yml, not passed through:
#   ROEDY_LISTEN=0.0.0.0:8080      public port, reached by Caddy only
#   ROEDY_INTERNAL_LISTEN          <ROEDY_HUB_APPS_IP>:8081, see above
#   ROEDY_DATA_DIR=/data           the volume roedy-hub-data
#   ROEDY_WEB_DIR                  development only; the image embeds the web app

# Caddy's image tag (default 2) and, for special cases only, its site address
# (default ROEDY_PUBLIC_URL).
CADDY_IMAGE_TAG=
CADDY_SITE=

# Roedy Mail at <ROEDY_PUBLIC_URL>/mail (needs a version with hub mode):
# COMPOSE_PROFILES=mail starts it. The pairing code comes from the hub's
# Administration › Apps and is only needed until Mail is paired
# (docs/ops.md › Pairing an app). Mail's own instance key, image tag, user and
# number of proxies (the hub's ROEDY_TRUST_PROXY plus one) as for the hub.
# COMPOSE_PROFILES=mail
ROEDY_MAIL_IMAGE_TAG=
ROEDY_MAIL_PAIRING_CODE=
ROEDY_MAIL_SECRET_KEY=
ROEDY_MAIL_UID=
ROEDY_MAIL_GID=
ROEDY_MAIL_TRUST_PROXY=
