# Settings for deploy/compose.yml. Copy this file to .env next to compose.yml
# and adjust it:
#
#   cp .env.example .env && chmod 600 .env
#
# Empty values count as unset. All variables of the hub: docs/ops.md ›
# Configuration.

# Required: public address of the hub – https, host, no path; replace the
# example host with your own. Its DNS name must point at this host, and ports
# 443 (and 80) must be open: the hub gets the certificate for this host itself
# (docs/ops.md › TLS). The apps live under /<slug>/ of it. Without it, nothing
# starts.
ROEDY_PUBLIC_URL=https://app.example.com

# Required with ROEDY_TLS=acme (the default here): true accepts the terms of
# service of the CA (Let's Encrypt: its Subscriber Agreement, linked from its
# directory). Without it the hub refuses to start.
ROEDY_ACME_AGREE_TOS=

# Contact address for the account at the CA (optional).
ROEDY_ACME_EMAIL=

# The CA's ACME directory; empty means Let's Encrypt production. For a first
# try use Let's Encrypt's staging directory (far higher rate limits, but
# browsers do not trust its certificates), then empty it and restart:
# ROEDY_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
ROEDY_ACME_DIRECTORY=

# Built-in TLS: acme (default), files (a certificate of your own: mount it
# read-only into the container in compose.yml and set both paths, e.g.
# /run/roedy-tls/cert.pem) or off (only behind a proxy of your own, see
# ROEDY_TRUST_PROXY and docs/ops.md › Behind your own proxy).
ROEDY_TLS=
ROEDY_TLS_CERT_FILE=
ROEDY_TLS_KEY_FILE=

# Version of the hub's image: 0.1 follows the patches of 0.1.x, 0.1.0 is
# exactly that version, empty means latest (docs/ops.md › Updates).
ROEDY_IMAGE_TAG=

# User and group IDs the hub runs as (default 65532, the image's user). Only
# change them together with a data directory that belongs to these IDs, e.g. a
# bind mount; never 0 (docs/ops.md › Container user).
ROEDY_UID=
ROEDY_GID=

# Log filter (default info) and format: json (default) or text.
ROEDY_LOG=
ROEDY_LOG_FORMAT=

# Number of reverse proxies in front of the hub. Leave it empty while the hub is
# exposed directly (the default): otherwise any client could choose its IP
# address with X-Forwarded-For. Only behind a proxy of your own, with
# ROEDY_TLS=off: true for one (and the apps 2, ROEDY_MAIL_TRUST_PROXY).
ROEDY_TRUST_PROXY=

# Instance key for secrets in the database: 64 hex characters
# (openssl rand -hex 32). Without it, the first start creates /data/secret.key.
# Back it up either way (docs/ops.md › Instance key). Alternatively a path to a
# file with the key inside the container, e.g. /run/secrets/roedy_secret_key;
# not both. compose.yml does not provide that file: add a Docker secret or a
# read-only volume for it there, otherwise the hub does not start.
ROEDY_SECRET_KEY=
ROEDY_SECRET_KEY_FILE=

# The private network of the hub and the apps, and the hub's fixed address in
# it (its internal listener binds to that address only). Change both together
# if the subnet collides with a network of the host.
ROEDY_APPS_SUBNET=
ROEDY_HUB_APPS_IP=

# Fixed by the image and compose.yml, not passed through:
#   ROEDY_LISTEN=0.0.0.0:8443      HTTPS, published as 443 (with ROEDY_TLS=off
#                                  0.0.0.0:8080, plain HTTP)
#   ROEDY_HTTP_LISTEN=0.0.0.0:8080 ACME HTTP-01 and the redirect to HTTPS,
#                                  published as 80
#   ROEDY_INTERNAL_LISTEN          <ROEDY_HUB_APPS_IP>:8081, see above; never
#                                  published
#   ROEDY_DATA_DIR=/data           the volume roedy-hub-data (also holds the
#                                  certificate)
#   ROEDY_WEB_DIR                  development only; the image embeds the web app

# Roedy Mail at <ROEDY_PUBLIC_URL>/mail (needs a version with hub mode):
# COMPOSE_PROFILES=mail starts it. The pairing code comes from the hub's
# Administration › Apps and is only needed until Mail is paired
# (docs/ops.md › Pairing an app). Mail's own instance key, image tag, user and
# number of proxies (the hub's ROEDY_TRUST_PROXY plus one; default 1, the hub)
# as for the hub.
# COMPOSE_PROFILES=mail
ROEDY_MAIL_IMAGE_TAG=
ROEDY_MAIL_PAIRING_CODE=
ROEDY_MAIL_SECRET_KEY=
ROEDY_MAIL_UID=
ROEDY_MAIL_GID=
ROEDY_MAIL_TRUST_PROXY=
