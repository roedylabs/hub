{
  "name": "@roedy/hub-web",
  "version": "0.0.0",
  "private": true,
  "description": "SvelteKit SPA of Roedy Hub",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --silent",
    "check": "pnpm run sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm run sync && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@inlang/paraglide-js": "3.2.2",
    "@roedy/tokens": "workspace:*",
    "@sveltejs/kit": "3.3.1",
    "@tabler/icons-svelte-runes": "3.52.0",
    "qrcode": "1.5.4",
    "svelte": "5.58.0"
  },
  "devDependencies": {
    "@inlang/plugin-message-format": "4.6.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
